# Для docker compose: cp .env.example .env
# Пустой VITE_API_URL = демо-данные.

# Адрес API, например https://api.example.com/api или /api (если API на том же домене)
VITE_API_URL=
# ID бота — цифры из токена до двоеточия. Нужен для входа через Telegram на сайте
VITE_TG_BOT_ID=
# Username бота без @, для кнопки «Открыть в Telegram» на странице входа
VITE_TG_BOT_USERNAME=

# Путь админки, если она на домене кабинета (app.example.com/admin/). Иначе /
ADMIN_BASE_PATH=/

MINIAPP_PORT=8080
ADMIN_PORT=8081
