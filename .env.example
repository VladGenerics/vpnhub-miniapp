# Для docker compose. Для локального запуска через npm — apps/*/.env.example.

# Адрес API бэкенда. Пусто — сборка на демо-данных.
VITE_API_URL=https://api.example.com/api
# Числовой ID бота (часть токена до «:») для входа через Telegram на сайте.
# Домены кабинета и админки нужно привязать к боту: @BotFather → /setdomain
VITE_TG_BOT_ID=
# Username бота без @ — кнопка «Открыть в Telegram» на странице входа кабинета
VITE_TG_BOT_USERNAME=

# Путь админки, если она открывается на домене кабинета (https://app.example.com/admin/).
# Нужен, когда вход через Telegram на сайте: к боту привязывается только один домен.
ADMIN_BASE_PATH=/

# Порты на хосте
MINIAPP_PORT=8080
ADMIN_PORT=8081
