# Для docker compose: cp .env.example .env

# Адрес API, например https://api.example.com/api или /api (если API на том же домене за прокси)
VITE_API_URL=
# true - тестовые данные в памяти вместо API, для проверки без бэкенда
VITE_USE_MOCKS=false
# ID бота - цифры из токена до двоеточия. Нужен для входа через Telegram на сайте
VITE_TG_BOT_ID=
# Username бота без @, для кнопки «Открыть в Telegram» на странице входа
VITE_TG_BOT_USERNAME=

# Путь админки, если она на домене кабинета (app.example.com/admin/). Иначе /
ADMIN_BASE_PATH=/

# Порты на хосте. По умолчанию слушают только 127.0.0.1 (за HTTPS-прокси), 0.0.0.0 - для всех
BIND_ADDR=127.0.0.1
MINIAPP_PORT=8080
ADMIN_PORT=8081
