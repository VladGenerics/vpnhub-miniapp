# Адрес API бэкенда. Если не задан — панель работает на демо-данных.
VITE_API_URL=https://api.example.com/api
# Принудительно включить демо-данные даже при заданном VITE_API_URL
VITE_USE_MOCKS=false
# Вход через Telegram Login Widget: числовой ID бота (часть токена до «:»).
# Домен панели нужно привязать к боту в @BotFather → /setdomain
VITE_TG_BOT_ID=
# Путь, под которым открывается панель, например /admin/ (если она на домене кабинета).
# По умолчанию — корень домена.
VITE_BASE_PATH=/
