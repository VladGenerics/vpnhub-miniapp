# Для локального запуска: cp .env.example .env.local
# Пустой VITE_API_URL = демо-данные.

# Адрес API, например https://api.example.com/api
VITE_API_URL=
# Или локальный бэкенд без CORS: VITE_API_URL=/api и API_PROXY=http://localhost:8000
API_PROXY=

# ID бота (цифры из токена до двоеточия) — для входа через Telegram
VITE_TG_BOT_ID=

# Путь панели, если она на домене кабинета, например /admin/. Иначе /
VITE_BASE_PATH=/

# true — демо-данные даже с заданным VITE_API_URL
VITE_USE_MOCKS=false
