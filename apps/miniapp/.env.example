# Адрес API бэкенда. Если не задан — приложение работает на демо-данных.
VITE_API_URL=https://api.example.com/api
# Принудительно включить демо-данные даже при заданном VITE_API_URL
VITE_USE_MOCKS=false
# Вход с сайта через Telegram Login Widget: числовой ID бота (часть токена до «:»)
# и его username без @. Домен сайта нужно привязать к боту в @BotFather → /setdomain
VITE_TG_BOT_ID=
VITE_TG_BOT_USERNAME=
