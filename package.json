{
  "name": "vpnhub",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @vpnhub/miniapp",
    "dev:miniapp": "npm run dev -w @vpnhub/miniapp",
    "dev:admin": "npm run dev -w @vpnhub/admin",
    "build": "npm run build --workspaces --if-present",
    "build:miniapp": "npm run build -w @vpnhub/miniapp",
    "build:admin": "npm run build -w @vpnhub/admin",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write \"apps/*/src/**/*.{ts,tsx}\" \"packages/*/src/**/*.ts\" \"apps/*/vite.config.ts\""
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
